---
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLang, getTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = getTranslations(Astro.currentLocale);

const links = [
  { href: getRelativeLocaleUrl(lang, '/gallery'), label: t.nav.gallery },
  { href: getRelativeLocaleUrl(lang, '/about'), label: t.nav.about },
  { href: getRelativeLocaleUrl(lang, '/contact'), label: t.nav.contact }
];
const homeHref = getRelativeLocaleUrl(lang, '/');
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="nav">
  <a href={homeHref} class="site-title" aria-label={t.nav.home}>
    <img src="/V3redondo-negro.png" alt="" class="logo logo-light" />
    <img src="/V3redondo.png" alt="" class="logo logo-dark" />
    <span class="name">Víctor Casabella</span>
  </a>

  <button class="menu-toggle" aria-label={t.a11y.menu} aria-expanded="false" aria-controls="nav-links">
    <span class="bar"></span>
    <span class="bar"></span>
  </button>

  <div id="nav-links" class="nav-links">
    {links.map(({ href, label }) => (
      <a href={href} aria-current={current === href.replace(/\/$/, '') ? 'page' : undefined}>{label}</a>
    ))}
    <span class="controls">
      <LangToggle />
      <ThemeToggle />
    </span>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg);
    transition: background-color 0.3s;
  }

  .site-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .logo {
    width: 32px;
    height: auto;
  }

  .logo-dark,
  :global(.dark) .logo-light {
    display: none;
  }

  :global(.dark) .logo-dark {
    display: block;
  }

  .name {
    font-stretch: 125%;
    font-weight: 400;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .nav-links > a {
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.2s;
  }

  .nav-links > a:hover,
  .nav-links > a[aria-current='page'] {
    color: var(--ink);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }

  .bar {
    height: 1px;
    width: 100%;
    background: var(--ink);
    transition: transform 0.25s;
  }

  .menu-toggle.active .bar:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-toggle.active .bar:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.5rem var(--gutter) 2rem;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }

    .nav-links.active {
      display: flex;
    }

    .nav-links > a {
      font-size: 1.1rem;
      color: var(--ink);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const links = document.querySelector<HTMLElement>('.nav-links');

  const setOpen = (open: boolean) => {
    toggle?.classList.toggle('active', open);
    links?.classList.toggle('active', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => setOpen(!links?.classList.contains('active')));

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (!toggle?.contains(target) && !links?.contains(target)) setOpen(false);
  });
</script>
