---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import { CldImage } from 'astro-cloudinary';
import { getCldImageUrl } from 'astro-cloudinary/helpers';

const t = getTranslations(Astro.currentLocale);
const galleries = [
  { title: 'Test1', photos: await getCollection('test1') },
  { title: 'Todas', photos: await getCollection('all') }
];
---

<Layout title={`${t.gallery.title} | Vr33s`}>
  <div class="page">
    <h1 class="display page-title">{t.gallery.title}</h1>
    <div
      id="pswp-gallery"
      data-close={t.a11y.close}
      data-zoom={t.a11y.zoom}
      data-previous={t.a11y.previous}
      data-next={t.a11y.next}
      data-go-to={t.a11y.goTo}
      data-load-error={t.a11y.loadError}
    >
      {galleries.map(({ title, photos }) => (
        <section class="gallery-section">
          <header class="gallery-header">
            <h2 class="display">{title}</h2>
            <span class="label">{photos.length} {t.gallery.photos}</span>
          </header>
          <ul class="gallery">{photos.map(({ data: resource }) => {
            const fullSrc = getCldImageUrl({ src: resource.public_id, width: resource.width, height: resource.height });
            const alt = resource.context?.custom?.alt ?? '';
            const caption = resource.context?.custom?.caption ?? alt;
            return (
              <li class="gallery-item" style={`--r: ${resource.width / resource.height}`}>
                <a
                  href={fullSrc}
                  class="pswp-item"
                  data-pswp-width={resource.width}
                  data-pswp-height={resource.height}
                  data-caption={caption}
                  target="_blank"
                  rel="noreferrer"
                >
                  <CldImage
                    src={resource.public_id}
                    width={resource.width}
                    height={resource.height}
                    sizes="(max-width: 600px) 100vw, 50vw"
                    alt={alt}
                  />
                </a>
              </li>
            )
          })}</ul>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .gallery-section + .gallery-section {
    margin-top: clamp(4rem, 10vw, 8rem);
  }

  .gallery-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  /* Justified rows: each photo's width follows its aspect ratio (--r), so nothing is cropped
     and reading order matches the lightbox order. */
  .gallery {
    --row: clamp(160px, 22vw, 320px);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .gallery::after {
    content: '';
    flex-grow: 999;
  }

  .gallery-item {
    flex: var(--r) 1 calc(var(--r) * var(--row));
    background: var(--surface);
  }

  .gallery-item a {
    display: block;
    cursor: zoom-in;
  }

  .gallery-item :global(img) {
    width: 100%;
    height: auto;
    transition: opacity 0.3s;
  }

  .gallery:hover .gallery-item :global(img) {
    opacity: 0.55;
  }

  .gallery .gallery-item:hover :global(img),
  .gallery .gallery-item:focus-within :global(img) {
    opacity: 1;
  }

  @media (max-width: 600px) {
    .gallery {
      --row: 120px;
      gap: 6px;
    }
  }
</style>


<style is:global>
  .pswp {
    --pswp-bg: #0a0a0a;
  }

  .pswp__thumbnails-strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    display: flex;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    overflow-x: auto;
    background: rgba(0, 0, 0, 0.6);
    scrollbar-width: none;
  }

  .pswp__thumbnail {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0;
    overflow: hidden;
    cursor: pointer;
    background: none;
    opacity: 0.6;
    transition: opacity 0.2s, border-color 0.2s;
  }

  .pswp__thumbnail:hover {
    opacity: 0.9;
  }

  .pswp__thumbnail--active {
    opacity: 1;
    border-color: #fff;
  }

  .pswp__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 600px) {
    .pswp__thumbnail {
      width: 44px;
      height: 44px;
    }

    .pswp__custom-caption {
      bottom: 72px;
    }
  }

  .pswp__custom-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 88px;
    z-index: 10;
    padding: 0.6rem 1rem;
    text-align: center;
    color: #fff;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pswp__custom-caption:empty {
    display: none;
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const labels = document.getElementById('pswp-gallery')?.dataset ?? {};

  document.querySelectorAll('#pswp-gallery .gallery').forEach((galleryEl) => {
    const lightbox = new PhotoSwipeLightbox({
      gallery: galleryEl,
      children: 'a.pswp-item',
      loop: false,
      closeTitle: labels.close,
      zoomTitle: labels.zoom,
      arrowPrevTitle: labels.previous,
      arrowNextTitle: labels.next,
      errorMsg: labels.loadError,
      bgOpacity: 0.97,
      bgClickAction: 'close',
      // PhotoSwipe's touch tap handler doesn't distinguish image vs background
      // (unlike its mouse click handler, which bgClickAction relies on),
      // so on mobile every tap just toggles controls. Replicate the
      // image/background distinction here so tapping outside the photo closes it.
      tapAction(point, originalEvent) {
        const isImageTap = originalEvent.target.classList.contains('pswp__img');
        if (isImageTap) {
          this.element?.classList.toggle('pswp--ui-visible');
        } else {
          this.close();
        }
      },
      pswpModule: () => import('photoswipe')
    });

    lightbox.on('uiRegister', () => {
      lightbox.pswp.ui.registerElement({
        name: 'thumbnails-strip',
        order: 9,
        isButton: false,
        appendTo: 'wrapper',
        onInit: (el, pswp) => {
          el.className = 'pswp__thumbnails-strip';

          const numItems = pswp.getNumItems();

          for (let index = 0; index < numItems; index++) {
            const itemData = pswp.getItemData(index);
            const thumbImg = itemData.element?.querySelector('img');
            if (!thumbImg) continue;

            const thumbButton = document.createElement('button');
            thumbButton.type = 'button';
            thumbButton.className = 'pswp__thumbnail';
            thumbButton.setAttribute('aria-label', `${labels.goTo} ${index + 1}`);

            const img = document.createElement('img');
            img.src = thumbImg.src;
            img.alt = '';
            thumbButton.appendChild(img);

            thumbButton.addEventListener('click', () => {
              pswp.goTo(index);
            });

            el.appendChild(thumbButton);
          }

          const updateActive = () => {
            el.querySelectorAll('.pswp__thumbnail').forEach((node, i) => {
              node.classList.toggle('pswp__thumbnail--active', i === pswp.currIndex);
            });
            el.querySelector('.pswp__thumbnail--active')?.scrollIntoView({
              behavior: 'smooth',
              inline: 'center',
              block: 'nearest'
            });
          };

          pswp.on('change', updateActive);
          updateActive();
        }
      });

      lightbox.pswp.ui.registerElement({
        name: 'custom-caption',
        order: 8,
        isButton: false,
        appendTo: 'wrapper',
        onInit: (el, pswp) => {
          el.className = 'pswp__custom-caption';

          const updateCaption = () => {
            const itemData = pswp.getItemData(pswp.currIndex);
            el.textContent = itemData.element?.dataset.caption || '';
          };

          pswp.on('change', updateCaption);
          updateCaption();
        }
      });
    });

    lightbox.init();
  });
</script>
