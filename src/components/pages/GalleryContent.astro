---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import { CldImage } from 'astro-cloudinary';
import { getCldImageUrl } from 'astro-cloudinary/helpers';

const t = getTranslations(Astro.currentLocale);
const test1 = await getCollection('test1');
const all = await getCollection('all');
---

<Layout title={`${t.gallery.title} | Vr33s`}>
  <main>
    <h1>{t.gallery.title}</h1>
    <div id="pswp-gallery">
      <h2>Test1</h2>
      <div>
        <ul class="gallery">{test1.map(({ data: resource }) => {
          const fullSrc = getCldImageUrl({ src: resource.public_id, width: resource.width, height: resource.height });
          const alt = resource.context?.custom?.alt ?? '';
          const caption = resource.context?.custom?.caption ?? alt;
          return (
            <li class="gallery-item">
              <a
                href={fullSrc}
                class="pswp-item"
                data-pswp-width={resource.width}
                data-pswp-height={resource.height}
                data-caption={caption}
                target="_blank"
                rel="noreferrer"
              >
                <CldImage
                 src={resource.public_id}
                 width={resource.width}
                 height={resource.height}
                 alt={alt}/>
              </a>
            </li>
          )
        })}</ul>
      </div>
      <h2>Todas</h2>
      <div>
        <ul class="gallery">{all.map(({ data: resource }) => {
          const fullSrc = getCldImageUrl({ src: resource.public_id, width: resource.width, height: resource.height });
          const alt = resource.context?.custom?.alt ?? '';
          const caption = resource.context?.custom?.caption ?? alt;
          return (
            <li class="gallery-item">
              <a
                href={fullSrc}
                class="pswp-item"
                data-pswp-width={resource.width}
                data-pswp-height={resource.height}
                data-caption={caption}
                target="_blank"
                rel="noreferrer"
              >
                <CldImage
                 src={resource.public_id}
                 width={resource.width}
                 height={resource.height}
                 alt={alt}/>
              </a>
            </li>
          )
        })}</ul>
      </div>
    </div>
  </main>
</Layout>

<style>
 main {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem;
}

h1 {
  text-align: center;
  margin-bottom: 2rem;
}

.gallery {
  display: grid; /* Use grid layout */
  grid-template-columns: repeat(4, 1fr); /* 4 items per row */
  gap: 1rem; /* Space between items */
  margin-bottom: 3rem; /* Space between galleries */
}

h2 {
  text-align: center;
  margin-bottom: 1rem;
}

.gallery-item {
  position: relative;
  overflow: hidden;
  border-radius: 10px;
}

.gallery-item a {
  display: block;
  cursor: pointer;
}

.overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 1rem;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.gallery-item:hover .overlay {
  transform: translateY(0);
}

h3 {
  margin: 0;
  font-size: 1.2rem;
}

/* Make sure images are responsive */
.gallery-item img {
  width: 100%;
  height: auto;
  object-fit: cover;
}
@media (max-width: 1200px) {
  .gallery {
    grid-template-columns: repeat(3, 1fr); /* 3 items per row */
  }
}

@media (max-width: 800px) {
  .gallery {
    grid-template-columns: repeat(2, 1fr); /* 2 items per row */
  }
}

@media (max-width: 500px) {
  .gallery {
    grid-template-columns: 1fr; /* 1 item per row */
  }
}

</style>

<style is:global>
  .pswp__thumbnails-strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    display: flex;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    overflow-x: auto;
    background: rgba(0, 0, 0, 0.6);
  }

  .pswp__thumbnail {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    background: none;
    opacity: 0.6;
    transition: opacity 0.2s, border-color 0.2s;
  }

  .pswp__thumbnail:hover {
    opacity: 0.9;
  }

  .pswp__thumbnail--active {
    opacity: 1;
    border-color: #fff;
  }

  .pswp__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 600px) {
    .pswp__thumbnail {
      width: 44px;
      height: 44px;
    }

    .pswp__custom-caption {
      bottom: 72px;
    }
  }

  .pswp__custom-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 88px;
    z-index: 10;
    padding: 0.6rem 1rem;
    text-align: center;
    color: #fff;
    background: rgba(0, 0, 0, 0.4);
    font-size: 0.95rem;
  }

  .pswp__custom-caption:empty {
    display: none;
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  document.querySelectorAll('#pswp-gallery .gallery').forEach((galleryEl) => {
    const lightbox = new PhotoSwipeLightbox({
      gallery: galleryEl,
      children: 'a.pswp-item',
      loop: false,
      bgClickAction: 'close',
      // PhotoSwipe's touch tap handler doesn't distinguish image vs background
      // (unlike its mouse click handler, which bgClickAction relies on),
      // so on mobile every tap just toggles controls. Replicate the
      // image/background distinction here so tapping outside the photo closes it.
      tapAction(point, originalEvent) {
        const isImageTap = originalEvent.target.classList.contains('pswp__img');
        if (isImageTap) {
          this.element?.classList.toggle('pswp--ui-visible');
        } else {
          this.close();
        }
      },
      pswpModule: () => import('photoswipe')
    });

    lightbox.on('uiRegister', () => {
      lightbox.pswp.ui.registerElement({
        name: 'thumbnails-strip',
        order: 9,
        isButton: false,
        appendTo: 'wrapper',
        onInit: (el, pswp) => {
          el.className = 'pswp__thumbnails-strip';

          const numItems = pswp.getNumItems();

          for (let index = 0; index < numItems; index++) {
            const itemData = pswp.getItemData(index);
            const thumbImg = itemData.element?.querySelector('img');
            if (!thumbImg) continue;

            const thumbButton = document.createElement('button');
            thumbButton.type = 'button';
            thumbButton.className = 'pswp__thumbnail';
            thumbButton.setAttribute('aria-label', `Go to image ${index + 1}`);

            const img = document.createElement('img');
            img.src = thumbImg.src;
            img.alt = '';
            thumbButton.appendChild(img);

            thumbButton.addEventListener('click', () => {
              pswp.goTo(index);
            });

            el.appendChild(thumbButton);
          }

          const updateActive = () => {
            el.querySelectorAll('.pswp__thumbnail').forEach((node, i) => {
              node.classList.toggle('pswp__thumbnail--active', i === pswp.currIndex);
            });
            el.querySelector('.pswp__thumbnail--active')?.scrollIntoView({
              behavior: 'smooth',
              inline: 'center',
              block: 'nearest'
            });
          };

          pswp.on('change', updateActive);
          updateActive();
        }
      });

      lightbox.pswp.ui.registerElement({
        name: 'custom-caption',
        order: 8,
        isButton: false,
        appendTo: 'wrapper',
        onInit: (el, pswp) => {
          el.className = 'pswp__custom-caption';

          const updateCaption = () => {
            const itemData = pswp.getItemData(pswp.currIndex);
            el.textContent = itemData.element?.dataset.caption || '';
          };

          pswp.on('change', updateCaption);
          updateCaption();
        }
      });
    });

    lightbox.init();
  });
</script>
