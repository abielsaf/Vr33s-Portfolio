---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CldImage } from 'astro-cloudinary';
import { getTranslations } from '../../i18n/utils';

const t = getTranslations(Astro.currentLocale);

// First photo in the Cloudinary "profile" folder; an empty frame keeps the layout until one exists.
const portrait = (await getCollection('photos')).find(({ data }) => data.asset_folder === 'profile')?.data;
---

<Layout title={`${t.about.title} | Vr33s`}>
  <div class="page">
    <h1 class="display page-title">{t.about.title}</h1>
    <div class="about-content">
      {portrait ? (
        <CldImage
          src={portrait.public_id}
          width={portrait.width}
          height={portrait.height}
          sizes="(max-width: 768px) 360px, 40vw"
          alt={t.about.portraitAlt}
          class="profile-pic"
        />
      ) : (
        <div class="profile-pic" aria-hidden="true"></div>
      )}
      <div class="bio">
        <p>{t.about.bio1}</p>
        <p>{t.about.bio2}</p>
        <h2 class="label">{t.about.skills}</h2>
        <ul>
          <li>Skill 1</li>
          <li>Skill 2</li>
          <li>Skill 3</li>
          <li>Skill 4</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

<style>
  .about-content {
    display: grid;
    grid-template-columns: minmax(220px, 4fr) 6fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .profile-pic {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--surface);
  }

  .bio {
    max-width: 60ch;
    font-size: 1.05rem;
  }

  .bio p {
    margin: 0 0 1.25rem;
  }

  h2 {
    margin: 3rem 0 1rem;
    font-weight: 400;
  }

  ul {
    border-top: 1px solid var(--line);
  }

  li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 768px) {
    .about-content {
      grid-template-columns: 1fr;
    }

    .profile-pic {
      max-width: 360px;
    }
  }
</style>
