---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/utils';

const t = getTranslations(Astro.currentLocale);

const apiKey = import.meta.env.WEB3FORMS_ACCESS_KEY;
---

<Layout title={`${t.contact.title} | Vr33s`}>
  <div class="page">
    <h1 class="display page-title">{t.contact.title}</h1>
    <div class="contact-container">
      <div class="contact-info">
        <h2>{t.contact.getInTouch}</h2>
        <p>{t.contact.reachOut}</p>
        <p>{t.contact.prefer}</p>
        <div class="contact-details">
          <div class="detail">
            <strong>{t.contact.email}:</strong>
            <a href="mailto:vr33s.photo@gmail.com">vr33s.photo@gmail.com</a>
          </div>
          <div class="detail">
            <strong>{t.contact.phone}:</strong>
            <a href="https://wa.me/34602696524" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">+34 602 69 65 24</a>
          </div>
        </div>
      </div>

      <!-- Web3Forms Contact Form -->
      <form id="form" class="contact-form" method="POST">
        <input type="hidden" name="access_key" value={apiKey} />
        <input type="hidden" name="from_name" value="Potencial cliente">
        <input type="hidden" name="subject" value="Nuevo mensaje desde la web de Vr33s">
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

        <div class="form-group">
          <label for="name">{t.contact.form.name}</label>
          <input type="text" id="name" name="name" required />
        </div>

        <div class="form-group">
          <label for="email">{t.contact.form.email}</label>
          <input type="email" id="email" name="email" required />
        </div>

        <div class="form-group">
          <label for="message">{t.contact.form.message}</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
       <!--  <div class="h-captcha" data-captcha="true"></div> hCaptcha, necesita script-->
        <button type="submit" class="submit-btn">{t.contact.form.send}</button>
        <div id="result" class="form-result" data-sending={t.contact.form.sending} data-sent={t.contact.form.sent} data-error={t.contact.form.error}></div>
      </form>
    </div>
  </div>
</Layout>

<style>
  .contact-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 8vw, 8rem);
  }

  .contact-info h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 400;
  }

  .contact-info p {
    max-width: 45ch;
    color: var(--muted);
  }

  .contact-details {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.25rem;
  }

  .detail {
    display: grid;
    gap: 0.25rem;
  }

  .detail strong {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .detail a {
    font-size: 1.1rem;
    text-decoration: none;
    width: fit-content;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s;
  }

  .detail a:hover {
    border-color: var(--ink);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  input, textarea {
    padding: 0.6rem 0;
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    resize: vertical;
    transition: border-color 0.2s;
  }

  input:focus, textarea:focus {
    outline: none;
    border-bottom-color: var(--ink);
  }

  .submit-btn {
    align-self: flex-start;
    padding: 0.85rem 2rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--bg);
    background: var(--ink);
    border: 1px solid var(--ink);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .submit-btn:hover {
    color: var(--ink);
    background: transparent;
  }

  .form-result {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .contact-container {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  const form = document.getElementById('form');
  const result = document.getElementById('result');

  form.addEventListener('submit', function(e) {
    e.preventDefault();

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    result.style.display = "";
    result.textContent = result.dataset.sending;

    fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: json
    })
    .then((response) => {
      if (response.ok) {
        result.textContent = result.dataset.sent;
        form.reset();
      } else {
        console.error(response);
        result.textContent = result.dataset.error;
      }
    })
    .catch(error => {
      console.error(error);
      result.textContent = result.dataset.error;
    })
    .finally(() => {
      setTimeout(() => {
        result.style.display = "none";
      }, 3000);
    });
  });
</script>
