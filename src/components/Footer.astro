<style>
  /* Ensure full height and sticky footer */
  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
  }

  :global(main) {
    flex: 1;
  }

  /* Footer container styling */
  .footer-container {
    background-color: var(--nav-bg);
    padding: 0.5rem 1rem; /* Reduced padding */
    color: var(--text);
    text-align: center;
    border-top: 1px solid var(--hover-bg); /* Optional border */
    flex-shrink: 0;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem; /* Space between links and copyright */
    flex-wrap: wrap; /* Wrap content on smaller screens */
  }

  .footer-links {
    display: flex;
    gap: 1rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    color: var(--text);
    text-decoration: none;
    font-size: 1rem; /* Smaller font size for compact look */
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .footer-divider {
    color: var(--text);
    font-size: 1rem;
  }

  .footer-copyright {
    font-size: 1rem;
    color: var(--text);
  }
  .icon {
        display: block;
        fill: currentColor; /* Inherit color from parent */
        transition: fill 0.2s ease; /* Smooth color change */
    }

  /* Responsive adjustments for smaller screens */
  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column; /* Stack items on smaller screens */
      gap: 0.5rem;
    }

    .footer-links {
      gap: 0.5rem;
    }
  }
</style>
