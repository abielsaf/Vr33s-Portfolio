---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLang, getTranslations } from '../i18n/utils';
import FlagIcon from './FlagIcon.astro';

const currentLang = getLang(Astro.currentLocale);
const t = getTranslations(Astro.currentLocale);
const pathWithoutLocale = currentLang === 'en'
  ? Astro.url.pathname.replace(/^\/en/, '') || '/'
  : Astro.url.pathname;

const languages: { code: 'es' | 'en'; label: string }[] = [
  { code: 'es', label: 'Español' },
  { code: 'en', label: 'English' }
];
---

<div class="lang-dropdown">
  <button
    id="lang-dropdown-toggle"
    class="lang-dropdown-toggle"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={t.a11y.language}
  >
    <FlagIcon code={currentLang} />
    <span class="chevron">▾</span>
  </button>
  <ul id="lang-dropdown-menu" class="lang-dropdown-menu">
    {languages.map((lang) => (
      <li>
        <a
          href={getRelativeLocaleUrl(lang.code, pathWithoutLocale)}
          class:list={['lang-option', { active: lang.code === currentLang }]}
        >
          <FlagIcon code={lang.code} />
          <span>{lang.label}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .lang-dropdown {
    position: relative;
  }

  .lang-dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    height: 36px;
    padding: 0 0.5rem;
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s;
  }

  .lang-dropdown-toggle:hover {
    color: var(--ink);
  }

  .chevron {
    font-size: 0.65rem;
  }

  .lang-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 0.25rem);
    right: 0;
    min-width: 150px;
    padding: 0.35rem;
    background: var(--bg);
    border: 1px solid var(--line);
    z-index: 200;
  }

  .lang-dropdown-menu.open {
    display: block;
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.6rem;
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .lang-option:hover,
  .lang-option.active {
    color: var(--ink);
    background: var(--surface);
  }

  @media (max-width: 768px) {
    .lang-dropdown-menu {
      left: 0;
      right: auto;
    }
  }
</style>

<script>
  function setupLangDropdown() {
    const toggle = document.getElementById('lang-dropdown-toggle');
    const menu = document.getElementById('lang-dropdown-menu');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = menu.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('click', (event) => {
      if (!toggle.contains(event.target as Node) && !menu.contains(event.target as Node)) {
        menu.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  setupLangDropdown();
  document.addEventListener('astro:after-swap', setupLangDropdown);
</script>
