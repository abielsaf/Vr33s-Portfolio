---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLang, getTranslations } from '../i18n/utils';
import { getHeroPhoto } from '../lib/hero';
import { getCldImageUrl } from 'astro-cloudinary/helpers';
import { ThemeScript } from 'astro-theme-toggle';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentLanguage = getLang(Astro.currentLocale);
const t = getTranslations(Astro.currentLocale);

// Link preview (WhatsApp, Instagram, etc.): the home photo cropped to the 1200×630 preview size.
const hero = await getHeroPhoto();
const previewImage = hero && getCldImageUrl({ src: hero.public_id, width: 1200, height: 630, crop: 'fill', gravity: 'auto' });
---

<!doctype html>
<html lang={currentLanguage}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Víctor Casabella" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={t.meta.locale} />
    {previewImage && <meta property="og:image" content={previewImage} />}
    {previewImage && <meta property="og:image:width" content="1200" />}
    {previewImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="viewport" content="width=device-width" />
    <!-- Same logo as the header; the tab colour follows the OS theme, not the site toggle -->
    <link rel="icon" type="image/png" href="/V3redondo-negro.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="/V3redondo.png" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=DM+Mono&display=swap"
    />
    <ThemeScript />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --bg: #f3f3f1;
    --ink: #111111;
    --muted: #6b6b67;
    --line: #d9d9d5;
    --surface: #e9e9e6;

    --font-body: 'Archivo', system-ui, sans-serif;
    --font-mono: 'DM Mono', ui-monospace, monospace;
    --gutter: clamp(1rem, 3vw, 2.5rem);
    --nav-h: 4.5rem;
  }

  .dark {
    --bg: #0f0f0f;
    --ink: #ebebe8;
    --muted: #8a8a85;
    --line: #262626;
    --surface: #181818;
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-body);
    font-size: 16px;
    background: var(--bg);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    line-height: 1.6;
    transition: background-color 0.3s, color 0.3s;
  }

  main {
    flex: 1;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  a {
    color: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }

  /* Expanded, light, uppercase: used for the name and page titles only */
  .display {
    font-stretch: 125%;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.05;
  }

  /* Film edge-print style labels */
  .label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .page {
    padding: clamp(2rem, 6vw, 5rem) var(--gutter);
  }

  .page-title {
    font-size: clamp(1.75rem, 5vw, 3.5rem);
    margin: 0 0 clamp(2rem, 5vw, 4rem);
  }

  :focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
